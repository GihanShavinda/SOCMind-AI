# Postgres
POSTGRES_USER=socmind
POSTGRES_PASSWORD=socmind
POSTGRES_DB=socmind

# JWT — generate a strong random value for anything real:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- Optional AI assistant (Phase 4) ---
# Leave LLM_PROVIDER empty to use the deterministic rule-based assistant (default).
# To enable an LLM, set provider + key + model. Examples:
#   LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=anthropic   LLM_MODEL=claude-3-5-sonnet-20241022
#   LLM_PROVIDER=ollama      LLM_MODEL=llama3   (no key; local at :11434)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# --- AI investigation assistant (Phase 4) ---
# Optional. Leave LLM_PROVIDER empty to run the deterministic, evidence-grounded
# assistant (no API key needed). Set these to enable an LLM to draft the narrative
# (commands are ALWAYS taken from the approved catalog regardless).
#   LLM_PROVIDER = openai | anthropic | ollama
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=20
